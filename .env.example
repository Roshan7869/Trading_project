# ================================================
# Paper Trading Platform - Environment Variables
# Multi-User Architecture Configuration
# ================================================

# =====================
# INFRASTRUCTURE (REQUIRED)
# =====================

# Redis - For real-time messaging and caching
REDIS_URL=redis://localhost:6379

# MongoDB - Stores user data, orders, positions, and broker credentials
MONGO_URL=mongodb://localhost:27017/paper_trading

# Encryption Key - MUST match backend for credential decryption
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_32_character_encryption_key_here

# =====================
# BACKEND (REQUIRED)
# =====================

# Server Port
PORT=4000

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Node Environment
NODE_ENV=development

# JWT Secret (for legacy auth, if used)
JWT_SECRET=your_jwt_secret_here

# =====================
# CLERK AUTHENTICATION
# =====================

# Get from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# =====================
# FRONTEND
# =====================

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# =====================
# LEGACY SINGLE-USER MODE (OPTIONAL)
# Only needed if running data engine without database
# =====================

# Angel One SmartAPI - Get from https://smartapi.angelone.in/
# ANGEL_ONE_API_KEY=your_api_key
# ANGEL_ONE_CLIENT_CODE=your_client_id
# ANGEL_ONE_PIN=your_pin
# ANGEL_ONE_TOTP_SECRET=your_totp_secret

# ================================================
# IMPORTANT: Multi-User Mode
# ================================================
# In multi-user mode, broker credentials are stored per-user
# in MongoDB, encrypted with ENCRYPTION_KEY.
# 
# Users configure their broker via:
#   Frontend -> Settings Page -> Broker Configuration
#
# The data engine's SessionManager will:
#   1. Listen for 'broker_update' events on Redis
#   2. Fetch user credentials from MongoDB
#   3. Decrypt using ENCRYPTION_KEY
#   4. Start/stop broker sessions dynamically
# ================================================
