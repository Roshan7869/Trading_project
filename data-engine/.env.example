# Redis Configuration
REDIS_URL=redis://localhost:6379

# Angel One SmartAPI Credentials
# Get these from https://smartapi.angelone.in/
ANGEL_ONE_API_KEY=your_api_key_here
ANGEL_ONE_CLIENT_CODE=your_client_code
ANGEL_ONE_PIN=your_pin
ANGEL_ONE_TOTP_SECRET=your_totp_secret

# Instructions:
# 1. Register at https://smartapi.angelone.in/
# 2. Create a "Trading API" app to get your API Key
# 3. ANGEL_ONE_CLIENT_CODE is your trading account ID
# 4. ANGEL_ONE_PIN is your trading PIN
# 5. ANGEL_ONE_TOTP_SECRET is from setting up 2FA (Google Authenticator)
