# ================================================
# Paper Trading Platform - Render.com Deployment
# Environment Variables Configuration
# ================================================
# 
# INSTRUCTIONS:
# 1. Copy these variables to your Render.com service environment settings
# 2. Replace all placeholder values (marked with REPLACE_WITH_...) with actual values
# 3. For MongoDB, use MongoDB Atlas: https://cloud.mongodb.com
# 4. For Redis, use Upstash: https://upstash.com or Redis Cloud
# 5. Get Clerk keys from: https://dashboard.clerk.com
# ================================================

# =============================================
# INFRASTRUCTURE - REQUIRED FOR ALL SERVICES
# =============================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URL=REPLACE_WITH_YOUR_MONGODB_ATLAS_CONNECTION_STRING

# Redis Cloud/Upstash Connection String
# Format: redis://default:<password>@<host>:<port>
# OR: rediss://default:<password>@<host>:<port> (for TLS)
# Get from Upstash: https://upstash.com or Redis Cloud
REDIS_URL=REPLACE_WITH_YOUR_REDIS_CLOUD_URL

# Encryption Key for sensitive data (broker credentials)
# Generate with: openssl rand -base64 32
# MUST be the same across all services
ENCRYPTION_KEY=REPLACE_WITH_YOUR_32_CHAR_ENCRYPTION_KEY

# =============================================
# BACKEND SERVICE (Express.js)
# =============================================

# Server Port (Render assigns this automatically)
PORT=4000

# Node Environment
NODE_ENV=production

# CORS Origin - Your frontend URL on Render
# Example: https://your-app-frontend.onrender.com
CORS_ORIGIN=REPLACE_WITH_YOUR_FRONTEND_URL

# Test Mode - Set to false for production
TEST_MODE=false

# JWT Secret (for legacy auth fallback)
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET

# =============================================
# CLERK AUTHENTICATION - REQUIRED
# =============================================
# Get from: https://dashboard.clerk.com → API Keys
# Use PRODUCTION keys for deployment!

# Backend Secret Key (starts with sk_live_ or sk_test_)
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_CLERK_SECRET_KEY

# Backend Publishable Key (same as frontend)
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# =============================================
# FRONTEND SERVICE (Next.js)
# =============================================

# API URL - Your backend URL on Render
# Example: https://your-app-backend.onrender.com
NEXT_PUBLIC_API_URL=REPLACE_WITH_YOUR_BACKEND_URL

# Socket URL - Same as backend URL for WebSocket connections
NEXT_PUBLIC_SOCKET_URL=REPLACE_WITH_YOUR_BACKEND_URL

# Clerk Publishable Key (MUST start with pk_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# =============================================
# DATA ENGINE SERVICE (Python)
# =============================================

# Same Redis URL as above
# REDIS_URL=<same as above>

# Same MongoDB URL as above  
# MONGO_URL=<same as above>

# Same Encryption Key as above
# ENCRYPTION_KEY=<same as above>

# Python Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================
# OPTIONAL: BROKER CREDENTIALS (Single-User Mode)
# =============================================
# Only needed if NOT using multi-user database mode
# In production, users configure brokers via Settings UI

# Angel One SmartAPI
# Get from: https://smartapi.angelone.in/
# ANGEL_ONE_API_KEY=your_api_key
# ANGEL_ONE_CLIENT_CODE=your_client_id
# ANGEL_ONE_PIN=your_mpin
# ANGEL_ONE_TOTP_SECRET=your_totp_secret

# =============================================
# RENDER.COM SPECIFIC SETTINGS
# =============================================

# Health Check Path (for Render to monitor your service)
# Backend: /api/health
# Frontend: /

# =============================================
# QUICK REFERENCE: SERVICES TO DEPLOY ON RENDER
# =============================================
#
# 1. BACKEND (Web Service)
#    - Root Directory: backend-express
#    - Build Command: npm install && npm run build
#    - Start Command: npm start
#    - Environment: Node
#    - Required Env Vars: PORT, NODE_ENV, MONGO_URL, REDIS_URL, 
#                         CORS_ORIGIN, CLERK_SECRET_KEY, ENCRYPTION_KEY
#
# 2. FRONTEND (Web Service or Static Site)
#    - Root Directory: frontend-nextjs
#    - Build Command: npm install && npm run build
#    - Start Command: npm start
#    - Environment: Node
#    - Required Env Vars: NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SOCKET_URL,
#                         NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY
#
# 3. DATA ENGINE (Background Worker)
#    - Root Directory: data-engine
#    - Build Command: pip install -r requirements.txt
#    - Start Command: python market_simulator.py
#    - Environment: Python 3.10
#    - Required Env Vars: REDIS_URL, MONGO_URL, ENCRYPTION_KEY
#
# 4. STRATEGY ENGINE (Background Worker)
#    - Root Directory: data-engine
#    - Build Command: pip install -r requirements.txt
#    - Start Command: python strategy_engine.py
#    - Environment: Python 3.10
#    - Required Env Vars: REDIS_URL, MONGO_URL
#
# =============================================
# EXTERNAL SERVICES NEEDED
# =============================================
#
# 1. MongoDB Atlas (Free tier available)
#    - https://cloud.mongodb.com
#    - Create cluster → Get connection string
#    - Whitelist 0.0.0.0/0 for Render IPs
#
# 2. Upstash Redis (Free tier available)
#    - https://upstash.com
#    - Create database → Get Redis URL
#    - Enable TLS for production
#
# 3. Clerk Authentication (Free tier available)
#    - https://dashboard.clerk.com
#    - Create application
#    - Get API keys (use production keys!)
#    - Configure allowed redirect URLs
#
# =============================================
